{
  "name": "@speakai/mcp-server",
  "version": "1.21.1",
  "mcpName": "io.github.speakai/mcp-server",
  "description": "Official Speak AI MCP Server — capture meetings, search thousands of recordings, run async voice and video surveys, create clips, and automate workflows from your AI assistant.",
  "homepage": "https://docs.speakai.co/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speakai/speakai-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/speakai/speakai-mcp/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "speakai-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup && cp src/types.d.ts dist/index.d.ts",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build",
    "test": "vitest run",
    "sync": "tsx scripts/sync-plugin.ts",
    "sync:check": "tsx scripts/sync-plugin.ts --check",
    "verify:plugin": "tsx scripts/verify-plugin.ts",
    "verify:plugin:live": "tsx scripts/verify-plugin.ts --live",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "speak-ai",
    "transcription",
    "ai",
    "claude",
    "model-context-protocol"
  ],
  "author": "Vatsal Shah",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.1",
    "chalk-template": "^1.1.2",
    "commander": "^14.0.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@speakai/shared": "^2.1.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.6",
    "tsup": "^8.5.1",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  }
}
